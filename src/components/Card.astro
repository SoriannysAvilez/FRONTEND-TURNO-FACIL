---
import Diente from './Icons/Diente.astro';

interface Props {
    imagen?: string;
    titulo: string;
    nombre:string;
    descripcion: string;
}

const { imagen, titulo, nombre, descripcion } = Astro.props;
---

<div class="flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">

    
    <div class="h-48 w-full overflow-hidden bg-gray-100">
        {imagen ? (
            <img
                src={imagen}
                alt={titulo}
                class="h-full w-full object-cover"
            />
        ) : (
            <div class="flex h-full w-full items-center justify-center bg-gray-50 [&>svg]:h-24 [&>svg]:w-24">
                <Diente />
            </div>
        )}
    </div>

    
    <div class="flex flex-1 flex-col p-4">

        <h2 class="text-xl items-center text-center font-bold text-gray-900">
            {titulo}
        </h2>

        <h3 class="text-xl mt-2 items-center text-center font-bold text-blue-900">
            {nombre}
        </h3>

        <p class="mt-4 text-sm leading-6 text-gray-600 text-justify">
            {descripcion}
        </p>


        <div class="mt-auto pt-5">
            <slot />
        </div>

    </div>

</div>
