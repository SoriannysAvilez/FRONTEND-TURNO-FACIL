---
import links from "../data/headerLinks.json";
const anio = new Date().getFullYear();
---

<footer
  class="px-20 bg-slate-950 py-6 flex flex-col md:flex-row items-center justify-between text-xs text-slate-400"
>
  <div class="flex flex-col gap-4 w-full justify-between items-center max-w-7xl mx-auto">
    <nav class="flex flex-col md:flex-row gap-5">
      {
        links.map((link) => (
          <a
            href={link.path}
            title={link.alt}
            class="hover:text-white transition"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <p>© {anio} Odonto Nova. Todos los derechos reservados a TurnoFacil.</p>
  </div>
</footer>
