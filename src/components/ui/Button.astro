---
interface Props {
  variant?: "primary" | "secondary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  class: className = "",
  target,
  rel,
  disabled = false,
} = Astro.props;

const variants: Record<string , string> = {
  primary: "bg-orange-500 text-white hover:bg-orange-600",
  secondary: "bg-slate-800 text-white hover:bg-slate-700",
  outline:
    "border border-orange-500 text-orange-500 hover:bg-orange-500 hover:text-white",
  ghost: "text-orange-500 hover:bg-orange-100",
};

const sizes: Record<string, string> = {
  sm: "px-3 py-2 text-sm",
  md: "px-5 py-3 text-base",
  lg: "px-7 py-4 text-lg",
};

const classes = `inline-flex items-center justify-center gap-2 rounded-lg font-medium transition-all duration-300
  ${disabled ? "opacity-50 cursor-not-allowed pointer-events-none" : ""}
  ${variants[variant]}
  ${sizes[size]}`
// Safety: any link opened in a new tab must be isolated, unless the caller overrides rel.
const resolvedRel = rel ?? (target === "_blank" ? "noopener noreferrer" : undefined);
---

{
  href ? (
    <a
      href={disabled ? undefined : href}
      target={target}
      rel={resolvedRel}
      class={classes}
      aria-disabled={disabled || undefined}
      tabindex={disabled ? -1 : undefined}
    >
      <slot name="icon" />
      <slot />
    </a>
  ) : (
    <button type={type} disabled={disabled} class={classes}>
      <slot name="icon" />
      <slot />
    </button>
  )
}