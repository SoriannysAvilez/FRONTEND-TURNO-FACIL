---
// src/components/LoginForm.astro
// Componente de formulario de login. La lógica de fetch va en el <script> de abajo
// (se ejecuta en el navegador, Astro no la procesa en el servidor).

interface Props {
  registroHref?: string; // ruta de la página de registro
}

const { registroHref = "/registro" } = Astro.props;
---

<form id="formLogin" class="max-w-sm mx-auto flex flex-col gap-4 p-6 border rounded-lg">
  <h2 class="text-lg font-semibold text-slate-800">Iniciar sesión</h2>

  <div class="flex flex-col gap-1">
    <label for="email" class="text-sm text-slate-600">Email</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="border rounded-md px-3 py-2 text-sm"
      placeholder="tucorreo@ejemplo.com"
    />
  </div>

  <div class="flex flex-col gap-1">
    <label for="password" class="text-sm text-slate-600">Contraseña</label>
    <input
      type="password"
      id="password"
      name="password"
      required
      class="border rounded-md px-3 py-2 text-sm"
      placeholder="••••••••"
    />
  </div>

  <p id="errorLogin" class="text-sm text-red-600 hidden"></p>

  <!-- Botón principal: iniciar sesión -->
  <button
    type="submit"
    class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 disabled:opacity-50"
  >
    Ingresar
  </button>

  <!-- Enlace secundario: registro para usuarios sin cuenta -->
  <p class="text-sm text-slate-600 text-center">
    ¿No tienes cuenta?
    <a href={registroHref} class="text-indigo-600 hover:underline font-medium">
      Regístrate
    </a>
  </p>
</form>

<script>
  // Se ejecuta en el navegador. Envía las credenciales a POST /auth/login.
  import { login, getUsuario } from "../api/consulta";

  const form = document.getElementById("formLogin") as HTMLFormElement;
  const errorEl = document.getElementById("errorLogin") as HTMLParagraphElement;
  const botonSubmit = form.querySelector("button[type='submit']") as HTMLButtonElement;

  function mostrarError(mensaje: string) {
    errorEl.textContent = mensaje;
    errorEl.classList.remove("hidden");
  }

  function ocultarError() {
    errorEl.classList.add("hidden");
  }

  form.addEventListener("submit", async (evento) => {
    evento.preventDefault();
    ocultarError();

    const email = (form.querySelector("#email") as HTMLInputElement).value.trim();
    const password = (form.querySelector("#password") as HTMLInputElement).value;

    botonSubmit.disabled = true;
    botonSubmit.textContent = "Ingresando...";

    try {
      // El login solo devuelve el token: el usuario se pide después.
      const { token } = await login(email, password);
      localStorage.setItem("tf_token", token);

      const usuario = await getUsuario(token);
      localStorage.setItem("tf_usuario", JSON.stringify(usuario));

      // El panel /booking es solo para administradores; el cliente reserva
      // desde el formulario del home.
      window.location.href = usuario.rol === "admin" ? "/booking" : "/";
    } catch (error) {
      mostrarError(error.status ? error.message : "No se pudo conectar con el servidor");
    } finally {
      botonSubmit.disabled = false;
      botonSubmit.textContent = "Ingresar";
    }
  });
</script>