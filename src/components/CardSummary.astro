---
const { titulo, total, descripcion, color = 'text-blue-950' } = Astro.props;
---

<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <p class="text-sm text-slate-500">{titulo}</p>
  <p class={`mt-3 text-3xl font-bold ${color}`}>{total}</p>
  <p class="mt-1 text-sm text-slate-400">{descripcion}</p>
</div>